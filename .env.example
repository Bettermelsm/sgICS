# 复制为 .env 并填入真实值（不要提交到 git）
# 智谱 BigModel API Key（https://open.bigmodel.cn/ 控制台获取）
ZHIPU_API_KEY=
# 模型名以智谱控制台当前可用为准，例如 glm-4-flash / glm-4 / glm-5.3-flash
GLM_MODEL=glm-4-flash
# 智谱 OpenAI 兼容接口地址（一般不用改）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Django
DJANGO_SECRET_KEY=demo-secret-key-change-me
DJANGO_DEBUG=True
