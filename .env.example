# 复制为 .env 并填入真实值（不要提交到 git）
# cp .env.example .env

# ---- 大模型（智谱 BigModel，https://open.bigmodel.cn/ 控制台获取）----
ZHIPU_API_KEY=
# 对话模型名，以智谱控制台当前可用为准，例如 glm-4-flash
GLM_MODEL=glm-4-flash
# embedding 模型名（知识库向量化用），例如 embedding-2
ZHIPU_EMBED_MODEL=embedding-2
# 智谱 OpenAI 兼容接口地址（一般不用改）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/

# ---- Django ----
DJANGO_SECRET_KEY=demo-secret-key-change-me
DJANGO_DEBUG=True
# 首次启动自动创建的管理员账号
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin123
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ---- 数据与文件路径（Docker 里默认指向 /data 卷，可不改）----
DB_PATH=/data/db.sqlite3
MEDIA_PATH=/data/media
DOUYIN_STATE_PATH=/data/douyin_state.json
DOUYIN_DEBUG_DIR=/data/debug
# 真实抖店商家后台入口（网页版飞鸽改从后台右上角进入，见 docs/DOUYIN.md）
DOUYIN_ENTRY_URL=

# ---- 发送风控（默认值，可不改）----
# 服务时间窗口（北京时间），窗口外拒绝人工发送
SERVICE_HOURS=9-23
# 频率限制：每 SEND_LIMIT_MINUTES 分钟最多发送 SEND_LIMIT_COUNT 条
SEND_LIMIT_COUNT=20
SEND_LIMIT_MINUTES=10
# 熔断：近 SEND_FAIL_STREAK_MINUTES 分钟失败 SEND_FAIL_STREAK_LIMIT 次则停发
SEND_FAIL_STREAK_LIMIT=3
SEND_FAIL_STREAK_MINUTES=30
